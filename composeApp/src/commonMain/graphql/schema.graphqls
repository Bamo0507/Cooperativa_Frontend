type Query {
  login(user_name: String!, pass_code: String!): LoginPayload
  getHistory(accessToken: String!): History
  getAllMemembers: [Member!]!
}

type Member {
  usuarioId: Int!
  name: String!
}

type History {
  owedCapital: Float
  payedToCapital: Float
}

type LoginOk {
  access_token: String!
  user_type: String!
}

type LoginErr {
  message: String!
}

type LoginPayload {
  Ok: LoginOk
  Err: LoginErr
}
