type Query {
  getHistory(accessToken: String!): History

  getAllMemembers: [Member!]!

#  Relacionados a formulario de pagos
  getFinesById(accessToken: String!): [Fine!]!
}

# General
type Member {
  userId: String!
  name: String!
}

# Socios - Historial
type History {
  owedCapital: Float
  payedToCapital: Float
}

# Socios - Pagos -------
# Formulario de Pagos
type Fine {
  reason: String!
  quantity: Float!
}
